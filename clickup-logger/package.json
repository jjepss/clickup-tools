{
  "name": "clickup-logger",
  "version": "0.1.0",
  "private": false,
  "description": "Cloudflare Worker that logs ClickUp webhook events (currently taskStatusUpdated) to D1",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "db:migrate": "wrangler d1 execute clickup-events --remote --file=schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "license": "MIT"
}
